# =============================================================================
# Variáveis de ambiente — Plataforma de Planejamento Acadêmico
# Copie para ".env" (na raiz do repositório) para uso local. NUNCA versione .env.
# Valores abaixo são ILUSTRATIVOS. Onde cadastrar cada variável: ver DEPLOY.md.
#
# Legenda:  [SERVIDOR] só no backend/worker (segredo)   [PÚBLICA] pode ir ao navegador
#           [VERCEL] cadastrar na Vercel   [WORKER] cadastrar no serviço do worker
#           [LOCAL] apenas desenvolvimento local
# =============================================================================

# Ambiente: desenvolvimento | homologacao | producao            [VERCEL] [WORKER]
PLAN_AMBIENTE=desenvolvimento

# --- Banco de dados (Supabase PostgreSQL) ------------------- [SERVIDOR] [VERCEL] [WORKER]
# Local:   postgresql+psycopg://plan:plan@localhost:5432/plan_horario
# Vercel:  pooler em modo TRANSAÇÃO (porta 6543) — Supabase → Connect → "Transaction pooler"
#          postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Worker:  pooler em modo SESSÃO (porta 5432) ou conexão direta
#          postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# (Também são aceitos DATABASE_URL ou POSTGRES_URL, criados pela integração Supabase da Vercel.)
PLAN_DATABASE_URL=postgresql+psycopg://plan:plan@localhost:5432/plan_horario
# Migrações (alembic): conexão direta ou pooler de SESSÃO — nunca a porta 6543.  [SERVIDOR]
# PLAN_DATABASE_URL_MIGRACOES=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# auto | padrao | null  (auto = NullPool em serverless/porta 6543)
PLAN_DB_POOL=auto

# --- Autenticação ---------------------------------------------------------------
# local    = usuários e senhas da própria plataforma (bcrypt + JWT)       [VERCEL] [WORKER]
# supabase = Supabase Auth (recomendado em produção)
PLAN_AUTH_MODO=local
# Modo local: segredo de assinatura do JWT, 32+ caracteres aleatórios     [SERVIDOR]
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PLAN_JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
PLAN_JWT_EXPIRA_MINUTOS=480

# Modo supabase — Supabase → Project Settings → API / Data API
# [PÚBLICA]
PLAN_SUPABASE_URL=https://<ref>.supabase.co
# [PÚBLICA] chave anon/publishable (protegida por RLS)
PLAN_SUPABASE_ANON_KEY=<chave-anon-ou-publishable>
# Apenas se o projeto usar o segredo JWT legado (HS256); com chaves de assinatura
# assimétricas (padrão em projetos novos) a API valida pelo JWKS e isto fica vazio.
# [SERVIDOR]
PLAN_SUPABASE_JWT_SECRET=
# Opcional: permite que a plataforma envie convites do Supabase Auth.     [SERVIDOR] NUNCA no frontend
PLAN_SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site (redirecionamento dos e-mails de convite/recuperação)
PLAN_URL_PUBLICA=https://seu-projeto.vercel.app

# --- Execução do otimizador -----------------------------------------------------
# auto (thread localmente; fila na Vercel) | thread | fila | sincrono     [VERCEL] [WORKER]
PLAN_EXECUTOR=auto
PLAN_SOLVER_THREADS=4
PLAN_SOLVER_LIMITE_PADRAO_S=30
PLAN_SOLVER_LIMITE_MAX_S=600
# Início imediato do worker no GitHub Actions (somente servidor; token fine-grained com "Actions: Read and write")   [VERCEL]
PLAN_GITHUB_TOKEN=
# dono/repositorio e branch; vazios = detectados automaticamente na Vercel
PLAN_GITHUB_REPO=
PLAN_GITHUB_REF=
PLAN_MAX_JOBS_SIMULTANEOS=2
PLAN_WORKER_INTERVALO_S=5
PLAN_WORKER_HEARTBEAT_EXPIRA_S=300

# --- Diversos -------------------------------------------------------------------
# Origens permitidas para CORS (na Vercel frontend e API têm a mesma origem)
PLAN_CORS_ORIGENS=http://localhost:5173
PLAN_LIMITE_UPLOAD_MB=20
PLAN_LOG_LEVEL=INFO

# --- Carga inicial (python -m app.seed) ------------------------------- [LOCAL/ADMIN]
# Primeiro administrador real. No modo supabase, use o mesmo e-mail do Supabase Auth.
PLAN_ADMIN_EMAIL=admin@instituicao.edu.br
PLAN_ADMIN_SENHA=defina-uma-senha-forte
# Usuário de TESTE (python -m app.seed --usuario-teste): login "admin", senha "admin@123".
# No modo supabase, o e-mail abaixo deve ser criado no Supabase Auth com a mesma senha.
# Recusado com PLAN_AMBIENTE=producao.
PLAN_USUARIO_TESTE_EMAIL=admin@teste.local

# --- Testes automatizados ------------------------------------------------------ [LOCAL]
PLAN_TEST_DATABASE_URL=postgresql+psycopg://plan:plan@localhost:5432/plan_horario_test
